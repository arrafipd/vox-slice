{
    "name": "vox-slice",
    "version": "1.0.0",
    "scripts": {
        "predev": "node scripts/copy-ort.mjs && node scripts/build-rhymes.mjs",
        "dev": "vite",
        "prebuild": "node scripts/copy-ort.mjs && node scripts/build-rhymes.mjs",
        "build": "vite build && node scripts/prune-dist.mjs",
        "preview": "vite preview",
        "serve:dist": "node scripts/serve-dist.mjs 5190",
        "build:rhymes": "node scripts/build-rhymes.mjs",
        "test": "node --test tests/unit/*.test.mjs",
        "test:e2e": "node tests/e2e/run.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@breezystack/lamejs": "1.2.7",
        "@fontsource-variable/inter": "5.3.0",
        "@fontsource/bebas-neue": "5.3.0",
        "@fontsource/orbitron": "5.3.0",
        "@huggingface/transformers": "4.3.2",
        "cmu-pronouncing-dictionary": "3.0.0",
        "jszip": "3.10.2"
    },
    "devDependencies": {
        "playwright": "1.65.1",
        "vite": "8.3.8"
    },
    "type": "module",
    "private": true,
    "description": "Vox-Slice: slice words out of speech audio, in the browser. A Fire-Press tool."
